<% it.title = 'Set name' %>
<% layout("./base.eta") %>


<h1>Choose a user name</h1>
<form method="post">

	<% if (it.error) { %>
	<div class="error-line"><%= it.error %></div>
	<% } %>
	<label for="choose-name">User name</label>
	<input type="text" id="choose-name" name="chosen-username">
	<button class="buttonStyle inline-block">Choose</button>
</form>
