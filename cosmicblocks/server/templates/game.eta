<% it.title = 'Game' %>
<% layout("./base.eta") %>

<div id="container">
	<h1 id="chatToggle">&laquo;</h1>
	
	<div id="chatPanel">
		<h1>Chat</h1>
		
		<div id="logContainer">
			<div id="log"></div>
		</div>
		<form id="chat">
			
			<input id="chatInput" type="text" maxlength="140" value="" autocomplete="off" />
		</form>
	</div>
	
	<div id="lobby" class="hidden-during-gameplay">
		<h1>
			<span class="yourname"></span>, 
			welcome to Cosmic Blocks!
		</h1>
		
		<div class="buttons-and-stats">
			<div id="optionButtons">
				<!-- 
					@TODO: change the button div elements into button elements. But for this I need to rewrite the CSS to get rid of SCSS -> CSS 
					Because we don't want this compilation step. Because we can use css custom-properties to handle variables.
					And native CSS nesting is a thing now.
					
					And the existing CSS code can be cleaned up anyways.
				-->
				<button id="newgame"  class="buttonStyle hidden-for-ghost">Create Game</button>
				<button id="randgame" class="buttonStyle hidden-for-ghost">Random Game</button>
				<button id="practice" class="buttonStyle hidden-for-ghost">Practice Mode</button>
				
				<a
					id="howToPlay" 
					class="buttonStyle" 
					href="https://docs.google.com/document/d/1c_rIYxdl2udNHXPFnHj5ELoYPjtej4hDjy7nCHnceG0/edit" 
					target="_blank"
				>How to Play</a>
				<a 
					class="buttonStyle" 
					href="https://docs.google.com/document/d/1cIwGEWhQYZUPRn1sBzatFuVSNau3VPHxOu9ffszejU4/edit" 
					target="_blank"
				>Documentation</a>
				<button class="toggleAudio buttonStyle"></button>
				
				<button class="buttonStyle" id="rerollColor">New Color</button>
			</div>
			
			<div id="playerStats" class="hidden-for-ghost">
				<ul id="lobbyUserData">
					<li>Games Played<span class="stat" id="stat-games-played"></span></li>
					<li>Games Won<span class="stat" id="stat-games-won"></span></li>
					<li>Games Drawn<span class="stat" id="stat-games-drawn"></span></li>
					<li>Games Lost<span class="stat" id="stat-games-lost"></span></li>
					<li>Elo<span class="stat" id="stat-display-elo"></span></li>
				</ul>
			</div>
			
		</div>
		
		<div id="gameTypes">
			<div id="open"></div>
			<div id="inprogress"></div>
		</div>
		
	</div>
	
	<div id="leaderboard" class="hidden-during-gameplay">
		<h1>World Ranking</h1>
		<div id="rankingContainer">
			<table id="eloRank"></table>
		</div>
	</div>
	
	<div class="hidden-in-lobby" id="headBoardContainer">
		<div id="gameHead">
			<div id="playerLeft"></div>
			<div id="timeRemaining"></div>
			<div id="playerRight"></div>
		</div>
		<div id="board"></div>
		<div id="menuContainer">
			<div id="menuRightContainer">
				<div id="gameButtons">
					<div class="buttonStyle" id="forfeit">Forfeit</div>
					<div id="exit" class="buttonStyle">Exit to Lobby</div>
					<div class="buttonStyle notready" id="ready">Ready Up</div>
					<div class="buttonStyle" id="rematch"><span>Rematch</span></div>
					<div class="toggleAudio buttonStyle"></div>
				</div>
				
				<div id="bottomInfo"></div>
			</div>
			<div id="menu"></div>
		</div>
	</div>
	
</div>

<!-- small css code to make my modifications work. -->
<style>
.in-gameplay .hidden-during-gameplay {
	display: none;
}

.in-lobby .hidden-in-lobby{
	display: none;
}

.is-ghost .hidden-for-ghost {
	display: none;
}

button {
	font-size: 1rem;
}
.buttonStyle {
	white-space: nowrap;
}
#lobby #optionButtons {
	flex-wrap:wrap;
	gap: 2px;
}
</style>




<!-- load stuff which we will use within JS. -->

<template id="audio-button">
<svg
	version="1.2"
	baseProfile="tiny"
	xmlns="http://www.w3.org/2000/svg"
	xmlns:xlink="http://www.w3.org/1999/xlink"
	x="0px"
	y="0px"
	viewBox="0 0 400 400"
	overflow="scroll"
	xml:space="preserve"
>
	<!-- speaker icon -->
	<path d="M159,226.5c0,11-9,20-20,20H71c-11,0-20-9-20-20V174c0-11,9-20,20-20h68c11,0,20,9,20,20V226.5z"/>
	<path d="M75.3,189.3c-9.3,5.9-9.3,15.7,0,21.6l126.8,81.5c9.3,5.9,16.8,1.8,16.8-9.2V117c0-11-7.6-15.1-16.8-9.2L75.3,189.3z"/>
	
	<!-- audio on -->
	<path 
		class="audioOn"
		fill="none"
		stroke="#2652AA"
		stroke-width="20"
		stroke-linecap="round"
		stroke-miterlimit="10"
		d="M314,126c0,0,90,74,0,148"
	/>
	<circle
		class="audioOn"
		fill="#061059"
		cx="254"
		cy="200"
		r="21"
	/>
	<path
		class="audioOn"
		fill="none"
		stroke="#123A89"
		stroke-width="20"
		stroke-linecap="round"
		stroke-miterlimit="10"
		d="M279,153c0,0,70,47,0,94"
	/>
	
	<!-- audio off -->
	<line
		class="audioOff"
		fill="none"
		stroke="#890303"
		stroke-width="20"
		stroke-linecap="round"
		stroke-miterlimit="10"
		x1="249"
		y1="166"
		x2="318"
		y2="235"
	/>
	<line
		class="audioOff"
		fill="none"
		stroke="#890303"
		stroke-width="20"
		stroke-linecap="round"
		stroke-miterlimit="10"
		x1="318"
		y1="166"
		x2="249"
		y2="235"
	/>
</svg>
</template>


<script src="https://cdn.socket.io/4.8.1/socket.io.min.js" integrity="sha384-mkQ3/7FUtcGyoppY6bz/PORYoGqOl7/aSUMn2ymDOJcapfS6PHqxhRTMh1RR0Q6+" crossorigin="anonymous"></script>
<script src="https://code.jquery.com/jquery-3.1.1.slim.min.js" integrity="sha256-/SIrNqv8h6QGKDuNoLGA4iret+kyesCkHGzVUUV0shc=" crossorigin="anonymous"></script>
<script type="module" src="script/client.js"></script>
