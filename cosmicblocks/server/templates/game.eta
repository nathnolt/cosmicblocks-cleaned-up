<% it.title = 'Game' %>
<% layout("./base.eta") %>

<div class="app-container">
	
	<button class="chat__toggle">&laquo;</button>
	<div class="chat">
		<div class="chat__header">
			<h2>Chat</h2>
		</div>
		
		<div class="chat__scrollwrapper">
			<div class="chat__contents"></div>
		</div>
		<form class="chat__form">
			<input
				class="chat__input"
				type="text"
				maxlength="140"
				value=""
				autocomplete="off"
			/>
		</form>
	</div>
	
	<div class="lobby hidden-during-gameplay">
		<h1>
			<span class="yourname"></span>, welcome to Cosmic Blocks!
		</h1>
		
		<div class="lobby__buttons-stats">
			<div class="lobby__buttons">
				<!-- 
					@TODO: change the button div elements into button elements. But for this I need to rewrite the CSS to get rid of SCSS -> CSS 
					Because we don't want this compilation step. Because we can use css custom-properties to handle variables.
					And native CSS nesting is a thing now.
					
					And the existing CSS code can be cleaned up anyways.
				-->
				<button id="newgame"  class="buttonStyle hidden-for-ghost">Create Game</button>
				<button id="randgame" class="buttonStyle hidden-for-ghost">Random Game</button>
				<button id="practice" class="buttonStyle hidden-for-ghost">Practice Mode</button>
				
				<a
					href="https://docs.google.com/document/d/1c_rIYxdl2udNHXPFnHj5ELoYPjtej4hDjy7nCHnceG0/edit"
					target="_blank"
					class="buttonStyle"
				>How to Play</a>
				
				<a
					href="https://docs.google.com/document/d/1cIwGEWhQYZUPRn1sBzatFuVSNau3VPHxOu9ffszejU4/edit" 
					target="_blank"
					class="buttonStyle" 
				>Documentation</a>
				
				<button class="toggleAudio bg-style buttonStyle"></button>
				
				<button class="buttonStyle" id="rerollColor">New Color</button>
			</div>
			
			<ul class="lobby__player-stats hidden-for-ghost">
				<li>Games Played<span class="stat" id="stat-games-played"></span></li>
				<li>Games Won<span    class="stat" id="stat-games-won"></span></li>
				<li>Games Drawn<span  class="stat" id="stat-games-drawn"></span></li>
				<li>Games Lost<span   class="stat" id="stat-games-lost"></span></li>
				<li>Elo<span          class="stat" id="stat-display-elo"></span></li>
			</ul>
	
		</div>
		
		<div class="lobby__games">
			
			<div class="lobbygame dummy">
				<div class="lobbygame__header">
					Content
				</div>
				
				<div class="lobbygame__main">
				</div>
				
				<div class="lobbygame__buttons">
					<button class="lobbygame__join buttonStyle hidden-for-ghost join-game-button">Play</button>
					<button class="lobbygame__spectate buttonStyle spectate-game-button">Spectate</button>
				</div>
			</div>
			
			<!-- Just put the games in here I guess. -->
			
		</div>
		
	</div>
	
	<div class="game-container hidden-in-lobby">
		<div class="game__header h1">
			<div class="game__player-left"></div>
			
			<div class="game__turn-time">
				Turn <b class="game__turn"></b>, 
				Time <b class="game__time"></b>
			</div>
			
			<div class="game__player-right"></div>
		</div>
		
		<div class="game__board"></div>
		
		<div class="game__menu-container">
			
			<div class="game__buttons-container">
				<div class="game__buttons">
					<button class="buttonStyle" id="forfeit">Forfeit</button>
					<button class="buttonStyle" id="exit">Exit to Lobby</button>
					<button class="buttonStyle notready" id="ready">Ready Up</button>
					<button class="buttonStyle" id="rematch"><span>Rematch</span></button>
					<button class="buttonStyle toggleAudio bg-style"></button>
				</div>
				
				<div class="game__buttons-bottominfo"></div>
			</div>
			
			<div class="game__menu"></div>
		</div>
		
	</div>
	
	<div id="leaderboard" class="hidden-during-gameplay">
		<h1>World Ranking</h1>
		<div id="rankingContainer">
			<table id="eloRank"></table>
		</div>
	</div>
	
</div>




<!-- load stuff which we will use within JS. -->

<template id="audio-button">
<svg
	version="1.2"
	baseProfile="tiny"
	xmlns="http://www.w3.org/2000/svg"
	xmlns:xlink="http://www.w3.org/1999/xlink"
	x="0px"
	y="0px"
	viewBox="0 0 400 400"
	overflow="scroll"
	xml:space="preserve"
>
	<!-- speaker icon -->
	<path d="M159,226.5c0,11-9,20-20,20H71c-11,0-20-9-20-20V174c0-11,9-20,20-20h68c11,0,20,9,20,20V226.5z"/>
	<path d="M75.3,189.3c-9.3,5.9-9.3,15.7,0,21.6l126.8,81.5c9.3,5.9,16.8,1.8,16.8-9.2V117c0-11-7.6-15.1-16.8-9.2L75.3,189.3z"/>
	
	<!-- audio on -->
	<path 
		class="audioOn"
		fill="none"
		stroke="#2652AA"
		stroke-width="20"
		stroke-linecap="round"
		stroke-miterlimit="10"
		d="M314,126c0,0,90,74,0,148"
	/>
	<circle
		class="audioOn"
		fill="#061059"
		cx="254"
		cy="200"
		r="21"
	/>
	<path
		class="audioOn"
		fill="none"
		stroke="#123A89"
		stroke-width="20"
		stroke-linecap="round"
		stroke-miterlimit="10"
		d="M279,153c0,0,70,47,0,94"
	/>
	
	<!-- audio off -->
	<line
		class="audioOff"
		fill="none"
		stroke="#890303"
		stroke-width="20"
		stroke-linecap="round"
		stroke-miterlimit="10"
		x1="249"
		y1="166"
		x2="318"
		y2="235"
	/>
	<line
		class="audioOff"
		fill="none"
		stroke="#890303"
		stroke-width="20"
		stroke-linecap="round"
		stroke-miterlimit="10"
		x1="318"
		y1="166"
		x2="249"
		y2="235"
	/>
</svg>
</template>


<script src="https://cdn.socket.io/4.8.1/socket.io.min.js" integrity="sha384-mkQ3/7FUtcGyoppY6bz/PORYoGqOl7/aSUMn2ymDOJcapfS6PHqxhRTMh1RR0Q6+" crossorigin="anonymous"></script>
<script src="https://code.jquery.com/jquery-3.1.1.slim.min.js" integrity="sha256-/SIrNqv8h6QGKDuNoLGA4iret+kyesCkHGzVUUV0shc=" crossorigin="anonymous"></script>
<script type="module" src="script/client.js"></script>
